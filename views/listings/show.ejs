<% layout("/layouts/boilerplate.ejs")%>
<body>
    <div class=" row offset-2">
    <h3><%=listing.title%></h3>
   

    <div class="card listing-card" style="width: 50rem;">
        <img src="<%=listing.image.url%>" class="card-img-top" alt="...">
        <div class="card-body">
          <p class="card-text">
            <p> Owner name : <%=listing.owner.username%></p>
            <li><%=listing.description%></li>
            <li>&#8377; <%=listing.price.toLocaleString("en-IN") %></li>
            <li><%=listing.location%></li>
            <li><%=listing.country%></li>
          </p>
        </div>
      </div>
    <%if(currUser && listing.owner._id.equals(currUser._id)){%>
   <div class="row">
    <div class="col-4">
    <a  href="/listings/<%=listing._id%>/edit">Edit this Listing</a>
     <br><br>
    </div>
     <div class="col-3">
    <form method="post" action="/listings/<%=listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-2">delete</button>
    </form>
    </div>
   </div>
   <%}%>
   <!-- Review -->
   <b> <hr></b>
     <div class="col-8 "><h4><b>All Review</b></h4>
      <%if(currUser){%>
      <form action="/listings/<%=listing.id%>/reviews" method="post" class="needs-validation" novalidate>
        <div class="mb-3 mt-3">
          <label for="Rating" >Rating</label>
<fieldset class="starability-slot">
  <legend>First rating:</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>


        </div>
        <div class="">
          <label for="comment" class="form-label" >Comments</label>
          <textarea  required name="review[comment]" id="comment" cols="30" rows="5" class="form-control"></textarea>
          <div class="invalid-feedback">Please submit some Comments for review</div>
        </div>
        <br>
        <button class=" btn btn-dark mb-3">submit</button>
      </form>
    </div>
    <hr>
   <%}%>
    <!--review -->
    <div class="row">
      <%for( let review of listing.reviews){%>
            
      <div class="card cardreviews col-5 mb-3" style="width: 18rem;">
        <div class="card-body">
          <h6 class="card-title"><b>@<%=review.author.username%></b></h6>
          <p class="card-text"><%=review.comment%></p>
           <p class="carf-text"><%=review.rating%> stars</p>
           <p class="starability-result" data-rating="<%=review.rating%>">
             <!-- Rated: 3 stars -->
           </p>
        </div>
        <%if(currUser && listing.owner._id.equals(currUser._id)){%>
        <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
          <button class="btn btn-sm btn-dark mb-1" >Delete</button>
        </form>
        <%}%>
      </div>
      <%}%>
     </div>
     <!-- map -->
     <div class="col-8 offset3 mb3">
       <h3>Where you'll be</h3>
       <div id="map"></div>
      </div>
</div>
<script>
  const ACCESS_TOKEN = '<%=process.env.MAP_TOKEN%>';
  const coordinates=<%=JSON.stringify(listing.geometry.coordinates)%>;
  console.log(ACCESS_TOKEN);
      mapboxgl.accessToken = ACCESS_TOKEN;
      const map = new mapboxgl.Map({
          container: 'map',
          style: 'mapbox://styles/mapbox/streets-v12',
          center:coordinates,
          zoom: 8.8
      });
     
      const marker=new mapboxgl.Marker({color:"red"})

      .setLngLat(coordinates)
      .setPopup(new mapboxgl.Popup({offset:20}).setHTML("<h3><%=listing.location%></h3>"))
      .addTo(map)

       console.log(coordinates)

  </script>

  
  
</body>
