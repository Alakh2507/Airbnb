<% layout("/layouts/boilerplate.ejs")%>
<body>
    <div class="row">
        <div class="col-8 offset-1"> 
             <h2>Create a New Listing</h2>
            <form   method="post" action="/listings" enctype="multipart/form-data"  class="needs-validation" novalidate >
        <!--listings ka abject key title -->
        <div class="mb-2 mt-3">
        <label for="title" class="form-label">Title</label>
        <input required name="listings[title]" type="text" placeholder="enter title" class="form-control">
        <div class="valid-feedback">
             good title 
          </div>
          <div id="invalidCheck3Feedback" class="invalid-feedback">
          Please enter title
          </div>
       </div>
        
        <div class="mb-2">
        <label for="description" class="form-label">Description</label>
        <textarea required row="10" name="listings[description]" type="text" placeholder="description" class="form-control"></textarea>
        <div id="invalidCheck3Feedback" class="invalid-feedback">
            Please enter description
            </div>
       </div>
           
        <!-- <div class="mb-2">
            <label for="image" class="form-label">Upload image</label>
        <input  name="listings[image]" id="image" type="text"class="form-control">
       </div> -->
             <!-- dfsdklfjds -->
       <div class="mb-3">
        <label for="image" class="form-label">Upload Listing Image</label>
        <input 
            name="listings[image]" 
            type="file"
            class="form-control">

    </div>

       <div class="mb-2">
        <label for="location" class="form-label">Location</label>
       <input required name="listings[location]" type="text" placeholder="enter location" class="form-control">
       <div id="invalidCheck3Feedback" class="invalid-feedback">
        Please enter location
        </div>
    </div>

        
       <div class="row">
                <div class="mb-2 col-md-4">
            <label for="price" class="form-label">Price</label>
        <input required name="listings[price]" placeholder="enter price" class="form-control">
        <div id="invalidCheck3Feedback" class="invalid-feedback">
            Please ente  a valid price
            </div>
    </div>
    
       <div class="mb-2 col-md-8">
        <label for="country" class="form-label">Country</label>
       <input required name="listings[country]" type="text" placeholder="enter country" class="form-control" >
       <div id="invalidCheck3Feedback" class="invalid-feedback">
         Country name should be valid 
        </div>
    </div> 
    </div>


        <br>
        <div class=" col-2">
       <button class="btn btn-dark mb-3"> add</button>
           </div>
    </form>
  </div>
</div>
   
</body>
